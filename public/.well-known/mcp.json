{
  "name": "e-nvoice WebMCP Server",
  "description": "Browser-native WebMCP server for creating and validating Factur-X / EN 16931 invoices",
  "version": "1.1.1",
  "protocolVersion": "2024-11-05",
  "transport": "window.postMessage",
  "tools": [
    {
      "name": "calculate_invoice_totals",
      "description": "Calculates subtotal HT, VAT per rate, and total TTC for a given set of invoice items",
      "inputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quantity": { "type": "number" },
                "unitPrice": { "type": "number" },
                "vatRate": { "type": "number" }
              },
              "required": ["quantity", "unitPrice", "vatRate"]
            }
          },
          "currency": { "type": "string", "enum": ["EUR", "USD", "GBP", "CHF"] }
        },
        "required": ["items"]
      }
    },
    {
      "name": "validate_invoice_data",
      "description": "Validates if invoice data contains required mandatory fields for Factur-X EN 16931 compliance",
      "inputSchema": {
        "type": "object",
        "properties": {
          "number": { "type": "string" },
          "date": { "type": "string" },
          "seller": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "siret": { "type": "string" },
              "vatNumber": { "type": "string" },
              "iban": { "type": "string" },
              "bic": { "type": "string" },
              "bankName": { "type": "string" }
            },
            "required": ["name"]
          },
          "buyer": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "siret": { "type": "string" },
              "vatNumber": { "type": "string" },
              "taxId": { "type": "string" }
            },
            "required": ["name"]
          },
          "buyerType": { "type": "string", "enum": ["business", "individual"] },
          "currency": { "type": "string", "enum": ["EUR", "USD", "GBP", "CHF"] },
          "operationType": { "type": "string", "enum": ["services", "goods", "mixed"] },
          "items": {
            "type": "array"
          }
        },
        "required": ["number", "date", "seller", "buyer", "items"]
      }
    },
    {
      "name": "generate_facturx_invoice",
      "description": "Generates and triggers download of a Factur-X PDF/A-3 file with XML metadata",
      "inputSchema": {
        "type": "object",
        "properties": {
          "number": { "type": "string" },
          "date": { "type": "string" },
          "dueDate": { "type": "string" },
          "currency": { "type": "string" },
          "buyerType": { "type": "string" },
          "operationType": { "type": "string" },
          "seller": { "type": "object" },
          "buyer": { "type": "object" },
          "items": { "type": "array" }
        },
        "required": ["number", "date", "seller", "buyer", "items"]
      }
    },
    {
      "name": "generate_facturx_xml",
      "description": "Generates raw Factur-X / EN 16931 XML string (UN/CEFACT CrossIndustryInvoice D16B)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice": { "type": "object" }
        },
        "required": ["invoice"]
      }
    }
  ]
}
